{
  "name": "fleet-control-frontend",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:local": "node scripts/capture-screenshots-with-preview.mjs",
    "screenshots:verify": "node scripts/verify-screenshots.mjs",
    "markdown:check": "node scripts/check-markdown-links.mjs",
    "preview": "vite preview --port 4173",
    "generate:api": "openapi-typescript ../openapi/openapi.json -o src/api/generated.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:check": "node node_modules/@sdlc/ui/scripts/sdlc-openapi-check.mjs --spec ../openapi/openapi.json --schema src/api/generated.ts",
    "openapi:compat": "SPEC=openapi/openapi.json SPEC_NAME=openapi/openapi.json node node_modules/@sdlc/ui/scripts/sdlc-openapi-compat.mjs",
    "postinstall": "openapi-typescript ../openapi/openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "@sdlc/ui": "file:../../services-base/frontend",
    "@hookform/resolvers": "^4.1.3",
    "@dicebear/core": "^9.4.3",
    "@dicebear/micah": "^9.4.3",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.11",
    "@tanstack/react-query": "^5.74.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.1.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.487.0",
    "openapi-fetch": "^0.13.5",
    "recharts": "^2.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^15.5.0",
    "react-router": "^8.1.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.25.60",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.0.0"
  }
}
