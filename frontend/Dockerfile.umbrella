# Umbrella build for the SDLC fleet root compose (context = /opt/dev/sdlc).
# Stages the sibling services-base frontend so the `@sdlc/ui` file dependency
# (../../services-base/frontend) resolves.
FROM node:22-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.28.1 --activate

WORKDIR /app
COPY fleet-control/frontend/package.json fleet-control/frontend/pnpm-lock.yaml fleet-control/frontend/pnpm-workspace.yaml ./
COPY services-base/frontend /services-base/frontend
COPY fleet-control/openapi/openapi.json ../openapi/openapi.json
RUN pnpm install --frozen-lockfile

COPY fleet-control/frontend/ ./
RUN pnpm build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY fleet-control/frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
