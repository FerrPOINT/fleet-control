# Fleet Control environment template
# Copy to .env and replace [CHANGE_ME] before production use.
#
# Env var format: FLEET_CONTROL_SECTION__KEY

FLEET_CONTROL_DATABASE__MAX_CONNECTIONS=20
FLEET_CONTROL_DATABASE__MIN_CONNECTIONS=5
FLEET_CONTROL_DATABASE__CONNECT_TIMEOUT_SECONDS=10
FLEET_CONTROL_DATABASE__IDLE_TIMEOUT_SECONDS=600

FLEET_CONTROL_JWT_SECRET=[CHANGE_ME]
FLEET_CONTROL_AUTH__MODE=hmac
FLEET_CONTROL_AUTH__JWT_ISSUER=fleet-control
FLEET_CONTROL_AUTH__JWT_AUDIENCE=sdlc
FLEET_CONTROL_AUTH__ACCESS_TOKEN_TTL_MINUTES=15
FLEET_CONTROL_AUTH__REFRESH_TOKEN_TTL_DAYS=7
FLEET_CONTROL_AUTH__REFRESH_COOKIE_NAME=refresh_token
FLEET_CONTROL_AUTH__REFRESH_COOKIE_SECURE=true
FLEET_CONTROL_AUTH__REFRESH_COOKIE_SAME_SITE=Lax
FLEET_CONTROL_AUTH__REFRESH_COOKIE_PATH=/api/v1/auth

FLEET_CONTROL_SERVER__ADDRESS=0.0.0.0
FLEET_CONTROL_SERVER__PORT=23801
FLEET_CONTROL_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:23802,http://localhost:5173

FLEET_CONTROL_FLEET__AGENTS_ROOT=./data/agents
# Activation requires an existing private Linux controller directory outside agents root.
FLEET_CONTROL_FLEET__CONTROLLER_ROOT=
FLEET_CONTROL_FLEET__HERMES_SOURCE=../прототипы/hermes
FLEET_CONTROL_FLEET__HERMES_COMMAND=hermes
FLEET_CONTROL_FLEET__JAVA_AGENT_SOURCE=../java-agent
FLEET_CONTROL_FLEET__JAVA_AGENT_COMMAND=java
FLEET_CONTROL_FLEET__RUNTIME_TOKEN_SECRET=[CHANGE_ME]
FLEET_CONTROL_FLEET__HERMES_CONTROL_OUTCOME_ENABLED=false
# Custody recovery only; does not authorize model/SDLC execution.
FLEET_CONTROL_FLEET__CONTROLLER_RECOVERY_ENABLED=false
# Signed activation-journal reconciliation only; requires private preserved storage.
FLEET_CONTROL_FLEET__CONFIGURATION_RECOVERY_ENABLED=false
FLEET_CONTROL_FLEET__AGENT_PORT_BASE=29000
FLEET_CONTROL_FLEET__AGENT_PORT_STRIDE=10

FLEET_CONTROL_METRICS__PUBLIC=true

POSTGRES_PASSWORD=[CHANGE_ME]
POSTGRES_USER=fleet_control
POSTGRES_DB=fleet_control

BACKEND_PORT=23801
BACKEND_HOST=127.0.0.1
FRONTEND_PORT=23802
FRONTEND_HOST=127.0.0.1

RUST_LOG=info

# Optional PM clarification gateway. Root URL, no credentials/query/path.
# Must equal the stable Task Tracker SDLC instance ID.
FLEET_CONTROL_TRACKER__URL=http://task-tracker:8080
FLEET_CONTROL_TRACKER__INSTANCE_ID=task-tracker-local

# Optional server-only PM assignment delegation. Not runtime admission/dispatch.
# Canonical central machine UUID must match Tracker's frozen PM machine subject.
# Root PAT has exactly task-tracker:read/write; Base delegation policy is opt-in.
FLEET_CONTROL_PM__CREDENTIALS__ENABLED=false
FLEET_CONTROL_PM__CREDENTIALS__AUTH_URL=http://auth:7701
FLEET_CONTROL_PM__CREDENTIALS__MACHINE_SUBJECT=
FLEET_CONTROL_PM__CREDENTIALS__PARENT_PAT=[CHANGE_ME]
FLEET_CONTROL_PM__CREDENTIALS__TTL_SECONDS=300
